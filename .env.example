# Sitewright configuration. All variables are optional; the defaults below
# are what the tool uses when a variable is absent.

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# Which provider drives the AI steps. "opencode" uses the models discovered
# from the local OpenCode installation (free-first); "openai-compatible"
# talks to any OpenAI-compatible chat-completions endpoint, typically
# OpenRouter (set OPENAI_API_KEY + OPENAI_BASE_URL below).
AI_PROVIDER=opencode

# A specific model to prefer for every AI step. It must be one of the models
# the provider can actually serve. When unset, the provider's free models are
# queried at startup and the cheapest suitable one is picked per step.
# Leave unset unless you know you want a particular model.
#AI_MODEL=

# Per-step overrides. A step reads AI_MODEL, else its own override, else the
# discovered free rotation.
#AI_MODEL_ANALYZE=
#AI_MODEL_GENERATE=
#AI_MODEL_MODIFY=
#AI_MODEL_REPAIR=

# Extra models to fall back to, comma-separated, tried after the primary.
#AI_FALLBACK_MODELS=

# How many transient provider/model errors are tolerated before the step
# gives up (each attempt may try a different free model).
#AI_MAX_MODEL_ATTEMPTS=4

# Timeout for a single model request.
#AI_REQUEST_TIMEOUT_MS=300000

# Send the model a screenshot of the source page while it classifies sections
# (multimodal). Costs tokens; disable on tiny models.
#AI_USE_VISION=true

# How many of the largest per-section screenshots to attach to that vision call.
#AI_MAX_SECTION_IMAGES=2

# For the openai-compatible provider:
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Hard guarantee: when set, only models whose published input AND output cost
# are both zero (verified against the live models.dev catalogue) may be
# called. A pay-per-token call becomes a failed run. Default is off
# (free-first ranking; unverified models may be tried as last resort).
#AI_FREE_ONLY=1

# ---------------------------------------------------------------------------
# Server / preview
# ---------------------------------------------------------------------------
# Port for the control panel (next dev / next start).
PORT=4310

# Port range for preview servers. Each generated site runs its own `next
# start` on one of these; the range must be open locally.
PREVIEW_PORT_START=4320
PREVIEW_PORT_END=4339

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info

# How long a discovered model catalogue is trusted before re-querying (ms).
#AI_MODEL_CACHE_TTL_MS=300000

# Bounded repair: how many regenerate/rebuild attempts are allowed before a
# project is left in "failed" with the last error. Never infinite.
#AI_MAX_STRUCTURE_ATTEMPTS=3